{
  "name": "levelup",
  "version": "1.0.0",
  "private": true,
  "description": "LEVEL UP – lokalus įpročių ir dienos užduočių sekiklis su XP, lygiais ir titulais (PWA).",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/app.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/app.css --watch",
    "build:icons": "node scripts/build-icons.js",
    "build": "npm run build:icons && npm run build:css",
    "serve": "npx http-server . -p 8080 -c-1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide": "^0.469.0",
    "tailwindcss": "^3.4.19"
  }
}
